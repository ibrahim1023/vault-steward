{
  "name": "vault-steward",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "package:plugin": "npm run build && tsx scripts/package-plugin.ts",
    "test:plugin-install": "npm run package:plugin && tsx scripts/plugin-install-smoke.ts",
    "test:unit": "vitest run tests/agents tests/core tests/deterministic-agents.test.ts tests/contracts tests/decisions tests/diagnostics tests/evals tests/feedback tests/findings tests/graph tests/indexing tests/maintenance tests/model-provider tests/observability tests/packaging tests/performance tests/plugin tests/policy tests/privacy tests/reference tests/resilience tests/review tests/schema tests/security tests/tasks tests/ui tests/docs tests/storage tests/vault-adapter",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:e2e": "vitest run tests/e2e",
    "test:acceptance": "vitest run tests/acceptance",
    "eval:smoke": "tsx scripts/run-evals.ts --suite reference-integrity",
    "eval:full": "tsx scripts/run-evals.ts --all",
    "eval:synthetic": "tsx scripts/run-synthetic-scale-eval.ts",
    "eval:retrieval": "tsx scripts/run-retrieval-quality-eval.ts",
    "evals": "tsx scripts/run-evaluation-framework.ts",
    "eval:local-model": "tsx scripts/run-live-model-evals.ts",
    "eval:marketplace:ollama": "tsx scripts/run-marketplace-release-eval.ts --provider ollama",
    "eval:marketplace:hyperfusion": "tsx scripts/run-marketplace-release-eval.ts --provider hyperfusion",
    "eval:marketplace:openai": "tsx scripts/run-marketplace-release-eval.ts --provider openai",
    "eval:marketplace:gate": "tsx scripts/check-marketplace-release.ts",
    "release:quality": "tsx scripts/generate-release-quality-report.ts",
    "perf:smoke": "tsx scripts/run-performance.ts",
    "ops:smoke": "tsx scripts/run-operational-baseline.ts",
    "security:check": "npm audit --omit=dev --audit-level=moderate"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sql.js": "^1.14.1",
    "unified": "^11.0.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "obsidian": "^1.8.7",
    "prettier": "^3.6.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
